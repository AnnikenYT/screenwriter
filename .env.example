# WARNING: none is an anonymous SHARED workspace. Every visitor can read, edit,
# restore and upload to every screenplay. Do not expose it to an untrusted network.
# Use OAuth and an HTTPS reverse proxy for Internet access. There are no per-doc ACLs.
AUTH_MODE=none
PORT=3000
BIND_ADDRESS=127.0.0.1
# Must exactly match the browser's public origin; used for Origin checks/callback.
# Proxy must support WebSocket Upgrade for /collaboration and forward cookies.
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Set AUTH_MODE=oauth and register PUBLIC_URL/auth/callback with your OIDC provider.
# Issuer must exactly match discovery metadata, including a trailing slash if any.
# Requires authorization-code flow with PKCE and RS256/PS256/ES256 ID tokens.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# CLIENT_ID / CLIENT_SECRET are also accepted as aliases outside Compose.
# Optional comma-separated domains. Requires email_verified=true when configured.
OIDC_ALLOWED_EMAIL_DOMAINS=
MAX_IMAGE_BYTES=10485760
MAX_UPDATE_BYTES=2097152
# Combined screenplay + scratchpad logical length limit (UTF-16 units, as in CM).
MAX_DOCUMENT_BYTES=8388608
# Separate bound for base CRDT state + uncompacted update journal, including
# deleted history and sheet/review metadata. Compaction cannot remove all CRDT IDs.
MAX_HISTORY_BYTES=67108864
# Incoming deltas are decoded/validated without cloning the entire document.
# A synchronous SQLite WAL transaction appends each delta before broadcasting.
# Invalid semantic updates reset the room to durable state (clients reconnect).
# Source length is checked in O(1); history budget conservatively counts deltas.
# Compaction encodes the full state only at this interval, snapshots and eviction.
COMPACT_AFTER_UPDATES=1000
MAX_CACHED_DOCUMENTS=100
MAX_WEBSOCKETS=1000
# Idle OAuth sockets are checked for expiration/revocation at every heartbeat;
# logout closes all sockets belonging to that browser session immediately.
HEARTBEAT_INTERVAL_MS=30000
AUTOSNAPSHOT_INTERVAL_MS=300000
# SQLite WAL, uploads and versions live in DATA_DIR (/data in Docker).
# Back up the whole volume consistently (stop container or use SQLite backup).
# Versions are retained indefinitely: monitor disk use. Cache limit is soft while
# rooms have connected clients. Uploaded images are signature-checked, not reencoded.
# PDF has a formatted title page, side-by-side dual dialogue, emphasis and blanks.
# PDF uses standard Courier (no embedded full-Unicode font), omits automatic
# (MORE)/(CONT'D) continuation cues, and clips long title metadata to fixed areas.
